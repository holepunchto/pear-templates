{
  "name": "pear-templates",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "pear": {
    "name": "templates",
    "stage": {
      "ignore": [
        "**/node_modules",
        "!/node_modules"
      ]
    },
    "platform": {
      "command": {
        "summary": "Create initial project files",
        "description": "Names:\n default, ui, node-compat",
        "arg [link|name]": "Link or named template to init from",
        "arg [dir]": "Project directory path (default: .)",
        "flag --yes|-y": "Autoselect all defaults",
        "flag --force|-f": "Force overwrite existing files",
        "flag --no-ask": "Suppress permission prompt"
      }
    }
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "dependencies": {
    "bare-signals": "^4.2.0",
    "paparam": "file:../paparam/paparam-1.9.1.tgz",
    "pear-gracedown": "^1.0.3",
    "pear-init": "^1.0.0",
    "pear-pipe": "^1.0.6",
    "pear-terminal": "file:../pear-terminal/pear-terminal-1.0.1.tgz"
  }
}
