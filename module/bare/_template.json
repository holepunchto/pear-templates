{
  "params": [
    {
      "name": "name",
      "prompt": "name"
    },
    {
      "name": "description",
      "prompt": "description",
      "default": ""
    },
    {
      "name": "author",
      "prompt": "author",
      "default": ""
    },
    {
      "name": "main",
      "prompt": "main",
      "default": "index.js"
    },
    {
      "name": "type",
      "default": "commonjs",
      "prompt": "type",
      "set": {
        "boilerplate": "(type) => type === 'commonjs' ? `'use strict'` : ``"
      }
    }
  ]
}